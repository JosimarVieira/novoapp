{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mvn -B -DskipTests package"
  },
  "deploy": {
    "startCommand": "java -Djava.net.preferIPv6Addresses=true -Dquarkus.profile=prod -jar target/quarkus-app/quarkus-run.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
